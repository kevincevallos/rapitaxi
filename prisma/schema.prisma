generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Cliente {
  id            Int      @id @default(autoincrement())
  whatsapp      String   @unique
  nombre        String
  fechaRegistro DateTime @default(now())

  carreras     Carrera[]
  conversacion ConversacionWhatsApp?
}

model Carrera {
  id     Int    @id @default(autoincrement())
  numero Int    @unique
  token  String @unique

  trackingToken String? @unique

  latitudTaxista        Float?
  longitudTaxista       Float?
  fechaUbicacionTaxista DateTime?

  ultimaNotificacionSeguimiento DateTime?

  nombreCliente   String
  whatsappCliente String

  latitud    Float
  longitud   Float
  referencia String
  formaPago  String

  estado EstadoCarrera @default(BUSCANDO)

  fechaCreacion   DateTime  @default(now())
  fechaAceptacion DateTime?
  fechaEnCamino   DateTime?
  fechaCerca      DateTime?
  fechaLlegada    DateTime?
  fechaFin        DateTime?

  calificacion String?
  canceladaPor String?

  clienteId Int?
  cliente   Cliente? @relation(fields: [clienteId], references: [id])

  taxistaId Int?
  taxista   Taxista? @relation(fields: [taxistaId], references: [id])
}

model Taxista {
  id       Int    @id @default(autoincrement())
  codigo   String @unique
  nombre   String
  placa    String @unique
  vehiculo String

  colorVehiculo String?
  cooperativa   String?

  telefono      String?
  activo        Boolean  @default(true)
  fechaRegistro DateTime @default(now())

  titularPichincha String?
  cuentaPichincha  String?

  titularGuayaquil String?
  cuentaGuayaquil  String?

  carreras      Carrera[]
  dispositivos  DispositivoTaxista[]
}

model DispositivoTaxista {
  id Int @id @default(autoincrement())

  deviceId     String @unique
  sessionToken String @unique

  expoPushToken String? @unique

  activo Boolean @default(true)
  enLinea Boolean @default(true)

  fechaRegistro      DateTime @default(now())
  fechaActualizacion DateTime @updatedAt

  taxistaId Int     @unique
  taxista   Taxista @relation(fields: [taxistaId], references: [id], onDelete: Cascade)
}

model ConversacionWhatsApp {
  id Int @id @default(autoincrement())

  telefono String  @unique
  nombre   String?

  estado EstadoConversacion @default(NUEVO)

  latitud    Float?
  longitud   Float?
  referencia String?

  carreraId Int?

  clienteId Int?     @unique
  cliente   Cliente? @relation(fields: [clienteId], references: [id])

  fechaCreacion      DateTime @default(now())
  fechaActualizacion DateTime @updatedAt
}

enum EstadoCarrera {
  BUSCANDO
  ASIGNADA
  EN_CAMINO
  CERCA
  LLEGO
  COMPLETADA
  CANCELADA
}

enum EstadoConversacion {
  NUEVO
  ESPERANDO_NOMBRE
  ESPERANDO_UBICACION
  ESPERANDO_PAGO
  BUSCANDO_TAXI
  CARRERA_ACTIVA
  ESPERANDO_CALIFICACION
}